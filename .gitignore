# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Local overrides (contain personal info)
*.local

# Backup directory
.dotfiles_backup/

# Scratch and one-off tooling: root-level paths prefixed with an underscore.
# Migration scripts, fetch logs and staging live here and are not part of the
# setup tool. Root-anchored so it never swallows a real file in a subdirectory.
/_*

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/

# App build output
app/node_modules/
app/src-tauri/target/
app/src-tauri/gen/

# Staged copy of config/lib/platforms, rebuilt by app/scripts/bundle-repo.js
app/src-tauri/bundled/
