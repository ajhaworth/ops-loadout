{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loadout",
  "version": "0.10.0",
  "identifier": "dev.alx.loadout",
  "build": {
    "beforeBuildCommand": "npm run bundle-repo",
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "loadout://localhost/index.html",
        "visible": false,
        "title": "Loadout",
        "width": 550,
        "height": 680,
        "minWidth": 480,
        "maxWidth": 550,
        "minHeight": 360,
        "transparent": true,
        "decorations": false
      },
      {
        "label": "quick",
        "url": "loadout://localhost/quick.html",
        "title": "Loadout Tray",
        "width": 340,
        "height": 400,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://www.google.com https://*.gstatic.com; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bridge.ps1": "bridge.ps1",
      "bundled/": "bundled/"
    }
  },
  "plugins": {}
}
