{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ops Launcher",
  "version": "0.2.2",
  "identifier": "dev.alx.ops-launcher",
  "build": {
    "beforeBuildCommand": "npm run bundle-repo",
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "ops://localhost/index.html",
        "visible": false,
        "title": "Ops Launcher",
        "width": 550,
        "height": 680,
        "minWidth": 480,
        "maxWidth": 550,
        "minHeight": 360,
        "transparent": true,
        "decorations": false
      },
      {
        "label": "quick",
        "url": "ops://localhost/quick.html",
        "title": "Ops Launcher",
        "width": 340,
        "height": 400,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://www.google.com https://*.gstatic.com; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bridge.ps1": "bridge.ps1",
      "bundled/": "bundled/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ajhaworth/ops-workstation/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMDhERDlFMTU0OUE3NzYKUldSMnAwa1ZudDBJOGp3QVgyd0JGTkJsQlVXb1YrbWs0aUxhSmo1cldxZFlSUVhFQUFYY0wwM3oK"
    }
  }
}
