{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ops Launcher",
  "version": "0.1.0",
  "identifier": "dev.alx.ops-launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Ops Launcher",
        "width": 920,
        "height": 680,
        "minWidth": 480,
        "minHeight": 360,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://www.google.com https://*.gstatic.com; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "bridge.ps1"
    ]
  }
}
