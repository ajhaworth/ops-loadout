<?xml version="1.0" encoding="UTF-8"?>
<!-- Caps Lock -> F18 at login, the key AeroSpace's window mode listens for (aerospace.toml). hidutil ships with
     macOS but forgets its mapping on reboot, hence this agent. 0x700000039 is Caps Lock, 0x70000006D is F18. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.alx.capslock-f18</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/hidutil</string>
        <string>property</string>
        <string>--set</string>
        <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x70000006D}]}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
