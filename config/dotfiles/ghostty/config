# Theme
theme = Catppuccin Mocha

# Font Settings
font-size = 16

# Disable ligatures for a consistent grid
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Cursor style
cursor-style = block

# Window appearance
macos-titlebar-style = tabs
# Linux/GTK only; macOS hides the bar at one tab natively
window-show-tab-bar = auto
background-opacity = 0.7
background-blur = 20

# Aesthetic Padding
window-padding-x = 10
window-padding-y = 10
window-save-state = always

# Behavior
confirm-close-surface = false
macos-option-as-alt = true
mouse-hide-while-typing = true
link-url = true

# Claude Code essentials
keybind = shift+enter=text:\n
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# Bell - notify when not focused
desktop-notifications = true

# Shell integration with SSH support
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# Tab titles: rename the current tab on demand
keybind = cmd+i=prompt_tab_title

# Quick terminal: drop-down from anywhere in macOS (unbound by default)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-autohide = false

# TUI launchers in the command palette (cmd+shift+p), typed into the shell
command-palette-entry = title:"tmux",description:"Attach to the main tmux session, or create it.",action:"text:tmux new -As main\n"
command-palette-entry = title:"htop",description:"Process viewer.",action:"text:htop\n"
command-palette-entry = title:"cliamp",description:"Terminal music player.",action:"text:cliamp\n"
